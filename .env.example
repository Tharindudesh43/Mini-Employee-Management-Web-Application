# Copy this file to ".env" and fill in your own values.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Your MySQL password. Leave it empty if you use XAMPP's default root user.
DB_PASSWORD=
DB_NAME=peopledesk
# Optional: maximum database connections per app copy (use 2 on Vercel)
# DB_POOL_LIMIT=2

# Long random text used to sign the session cookie. Replace this sample value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_value

# Log the user out after this many minutes without activity
SESSION_TIMEOUT_MINUTES=15

# First login account, created by "npm run db:setup"
# Log in with these. Change the password if you ever deploy this online.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123