# Copy this file to ".env" and fill in your own values.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=peopledesk

# Long random text used to sign the session cookie
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_value

# Log the user out after this many minutes without activity
SESSION_TIMEOUT_MINUTES=15

# First login account, created by "npm run db:setup"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
