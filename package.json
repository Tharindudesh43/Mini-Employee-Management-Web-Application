{
  "name": "peopledesk-employee-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Employee management dashboard with Express, MySQL and session-based login",
  "main": "server/index.js",
  "scripts": {
    "start": "node init && node server/index.js",
    "dev": "node init && node --watch server/index.js",
    "db:setup": "node server/scripts/setup-db.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "winston": "^3.19.0"
  }
}
